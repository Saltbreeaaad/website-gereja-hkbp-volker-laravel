APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hkbp_volker
DB_USERNAME=hkbp_volker
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB true di produksi. Tanpa ini cookie sesi tidak bertanda Secure, dan
# browser ikut mengirimkannya pada permintaan http mana pun ke domain yang sama
# — satu tautan http yang terlanjur tersebar cukup untuk membocorkan sesi
# pengurus yang sedang masuk. Dibiarkan false di lokal karena `php artisan
# serve` melayani http, dan cookie Secure tidak akan pernah terkirim ke sana.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Cadangan basis data -----------------------------------------------------
# Direktori tujuan cadangan. Arahkan ke luar pohon aplikasi bila penyebaran
# ulang menimpa isi proyek — cadangan yang ikut tertimpa bukan cadangan.
# DIREKTORI_CADANGAN=/var/backups/hkbp-volker

# Penyimpanan kedua (nama disk dari config/filesystems.php, mis. s3). Dibiarkan
# kosong berarti cadangan hanya ada di disk yang sama dengan basis datanya:
# cukup untuk salah hapus, tidak cukup untuk kegagalan disk.
# CADANGAN_DISK=
# CADANGAN_DISK_DIREKTORI=cadangan-basis-data

# --- Pengoptimal gambar ------------------------------------------------------
# Batas piksel yang boleh di-decode. Kosong berarti diturunkan sendiri dari
# memory_limit. Isi hanya bila hosting melaporkan memory_limit yang tidak
# mencerminkan jatah sebenarnya.
# MAKSIMAL_PIKSEL_GAMBAR=
